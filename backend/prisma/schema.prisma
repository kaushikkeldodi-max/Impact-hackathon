generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  fullName  String
  email     String   @unique
  phone     String?
  password  String
  country   String?
  location  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ApplicantProfile {
  id                 String   @id @default(cuid())
  userId             String   @unique
  primaryGoal        String
  preferredField     String?
  preferredCity      String?
  intakePeriod       String?
  currentQualification String?
  careerGoal         String?
  completeness       Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model DocumentRecord {
  id                    String   @id @default(cuid())
  applicantId           String
  name                  String
  type                  String
  uploadDate            DateTime @default(now())
  status                String
  extractionStatus      String
  verificationStatus    String
  confidence            Int
  detectedInformation   String[]
  issues                String[]
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model NotificationRecord {
  id          String   @id @default(cuid())
  applicantId String
  type        String
  subject     String
  message     String
  createdAt   DateTime @default(now())
  read        Boolean  @default(false)
  stage       String?
}

model JourneyStage {
  id        String   @id @default(cuid())
  applicantId String
  name      String
  status    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model QualificationAssessment {
  id          String   @id @default(cuid())
  applicantId String
  status      String
  score       Int
  matched     String[]
  missing     String[]
  unverified  String[]
  createdAt   DateTime @default(now())
}
